# ── Core ─────────────────────────────────────────────────
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ANTHROPIC_API_KEY=
PEXELS_API_KEY=

# ── Phase 2: Semantic Cache ───────────────────────────────
OPENAI_API_KEY=              # text-embedding-3-small for semantic cache

# ── Phase 3: Payments ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_BUILDER_PRICE_ID=
STRIPE_LEAD_PRICE_ID=
STRIPE_ESTIMATE_SINGLE_PRICE_ID=
STRIPE_ESTIMATE_FULL_PRICE_ID=
STRIPE_BOQ_PRICE_ID=
STRIPE_BOQ_HARDWARE_PRICE_ID=
STRIPE_BOQ_QUOTES_PRICE_ID=
STRIPE_PERMIT_PREP_PRICE_ID=
STRIPE_CONTRACT_PRICE_ID=
STRIPE_TAX_APPEAL_PRICE_ID=

# ── Phase 5-6: Uploads & Email ────────────────────────────
BLOB_READ_WRITE_TOKEN=       # Vercel Blob for plan uploads
RESEND_API_KEY=              # For hardware store quote emails
JARVIS_EMAIL=                # Email Jarvis monitors for store replies

# ── Public site config (all optional; hidden/disabled when unset) ──
NEXT_PUBLIC_SITE_URL=https://www.groundworksbhs.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Re-enable "BOQ + Hardware Store Quotes" once real store emails are in Admin → Hardware Stores
NEXT_PUBLIC_HARDWARE_QUOTES_ENABLED=false
# Show seeded sample contractors (labelled "Sample listing") for demos/QA only
SHOW_PLACEHOLDER_CONTRACTORS=false
# Optional dedicated secret for signed BOQ PDF links (falls back to CLERK_SECRET_KEY)
REPORT_LINK_SECRET=

# ── Builders Circle (Grand Bahama contractor portal) ─────────────
# Extra admins (comma-separated Clerk user ids). ADMIN_CLERK_ID still works on its own.
ADMIN_CLERK_IDS=
# Where admin notifications go (comma-separated). Defaults to leron@formartiq.com.
BUILDERS_CIRCLE_ADMIN_EMAILS=
# PREVIEW/TEST ONLY: send every Builders Circle email to this one address instead.
# Outside production nothing is sent unless this is set.
BUILDERS_CIRCLE_EMAIL_REDIRECT=
# Optional: folder prefix in the private Blob store (default builders-circle)
BUILDERS_CIRCLE_BLOB_PREFIX=
# Optional: dedicated secret for signed email links (falls back to REPORT_LINK_SECRET / CLERK_SECRET_KEY)
BUILDERS_CIRCLE_LINK_SECRET=
